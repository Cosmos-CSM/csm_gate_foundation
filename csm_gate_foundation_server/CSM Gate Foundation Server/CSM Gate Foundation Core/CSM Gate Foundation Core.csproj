<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <RootNamespace>CSM_Gate_Foundation_Core</RootNamespace>
	  <PackageId>CSM.GateFoundation.Core</PackageId>
	  <Version>0.0.1</Version>
	  <Authors>Renato Urrea</Authors>
	  <Company>Cosmos (CSM)</Company>
	  <RepositoryUrl>https://github.com/Cosmos-CSM/csm_gate_foundation</RepositoryUrl>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageReadmeFile>CHANGELOG.md</PackageReadmeFile>
	  <IsPackable>true</IsPackable>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup>
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSM.Security.Database.Core" Version="1.0.3" />
    <PackageReference Include="CSM.Server.Core" Version="2.1.7" />
  </ItemGroup>

</Project>
