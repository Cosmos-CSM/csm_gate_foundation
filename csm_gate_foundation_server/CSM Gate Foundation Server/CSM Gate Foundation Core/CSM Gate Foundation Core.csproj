<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <RootNamespace>CSM_Gate_Foundation_Core</RootNamespace>
	  <PackageId>CSM.GateFoundation.Core</PackageId>
	  <Version>1.0.0</Version>
	  <Authors>Renato Urrea</Authors>
	  <Company>Cosmos (CSM)</Company>
	  <RepositoryUrl>https://github.com/Cosmos-CSM/csm_gate_foundation</RepositoryUrl>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageReadmeFile>CHANGELOG.md</PackageReadmeFile>
	  <IsPackable>true</IsPackable>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup>
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSM.Security.Database.Core" Version="3.1.0" />
    <PackageReference Include="CSM.Server.Core" Version="2.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
